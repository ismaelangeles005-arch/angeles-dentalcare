{
  "appId": "com.angeles.dentalcare",
  "productName": "Angeles DentalCare",
  "copyright": "Copyright 2026 Angeles DentalCare",
  "artifactName": "AngelesDentalCare-Setup-${version}.${ext}",
  "executableName": "AngelesDentalCare",
  "asar": true,
  "directories": {
    "output": "../../installer/windows/dist"
  },
  "files": [
    "src/**/*",
    "resources/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../server",
      "to": "server",
      "filter": [
        "src/**/*",
        "scripts/**/*",
        "database/**/*",
        "package.json",
        "package-lock.json",
        ".env.example"
      ]
    },
    {
      "from": "../../server/node_modules",
      "to": "server/node_modules"
    },
    {
      "from": "../../shared",
      "to": "shared"
    },
    {
      "from": "../../",
      "to": "frontend",
      "filter": [
        "*.html",
        "*.css",
        "*.js",
        "images/logo.svg",
        "images/logo_files/**/*"
      ]
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "../../resources/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Angeles DentalCare",
    "uninstallDisplayName": "Angeles DentalCare",
    "deleteAppDataOnUninstall": false
  },
  "extraMetadata": {
    "name": "angeles-dentalcare",
    "version": "1.0.0",
    "description": "Sistema de gestion odontologica Angeles DentalCare",
    "main": "src/main.js"
  }
}
