PORT=3001
# DEVELOPMENT example. See DEPLOYMENT.md before configuring production.
# REQUIRED PRODUCTION: NODE_ENV=production and all required values supplied.
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/dentalcare
JWT_SECRET=
PIN_LOOKUP_SECRET=
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://127.0.0.1:5500
# Production requires an absolute EXISTING writable persistent private directory.
PATIENT_FILES_DIR=

# OPTIONAL API/session. PORT and JWT_EXPIRES_IN above retain local defaults.
PIN_MAX_ATTEMPTS=5
PIN_LOCK_SECONDS=30
# Only explicit proxy IPs/CIDRs, never blanket true or hop counts.
TRUST_PROXY=false
# Render production only, after verifying trusted edge ingress; leave empty locally.
# Also requires Render's own RENDER=true. Does not enable Express trust proxy.
TRUSTED_CLIENT_IP_SOURCE=
# Empty = API only. Otherwise dedicated public artifact, never the repository.
FRONTEND_ROOT=

# OPTIONAL pool. Empty PG_TLS = local disable / remote production verify-full.
# Render INTERNAL URL, same region/private network: explicitly set PG_TLS=require.
# require encrypts but does NOT verify CA/hostname. Never put sslmode in DATABASE_URL.
# verify-full verifies CA/hostname; PG_TLS_CA_FILE is optional only in that mode.
PG_TLS=
PG_TLS_CA_FILE=
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# REVIEW PROVISIONING ONLY: inject temporarily; never commit filled values.
REVIEW_ORGANIZATION_NAME=
REVIEW_ADMIN_USERNAME=
REVIEW_ADMIN_NAME=
REVIEW_ADMIN_PASSWORD=
REVIEW_ADMIN_ROLE=admin
